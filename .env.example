# Copy this file to .env and fill in only the services you use.
# Never commit .env or paste real credentials into this example file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:3000
APP_SIGNING_SECRET=
WORKER_CALLBACK_SECRET=
REPORT_LINK_TTL_HOURS=72

# -----------------------------------------------------------------------------
# REQUIRED INFRASTRUCTURE, NOT A HACKATHON SPONSOR: Supabase
# Use the current sb_publishable_ and sb_secret_ keys for new projects.
# The secret key is server-only and must never use a NEXT_PUBLIC_ prefix.
# SUPABASE_ACCESS_TOKEN and SUPABASE_PROJECT_REF are only needed for CLI setup.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ARTIFACT_BUCKET=paybench-artifacts

# -----------------------------------------------------------------------------
# REQUIRED SPONSOR: Terac — paid human research and expert feedback
# Create a key in Terac organization settings. Keys start with tk_.
# Codex can use OAuth instead: codex mcp login terac
# -----------------------------------------------------------------------------
TERAC_API_KEY=
TERAC_MCP_URL=https://terac.com/api/mcp
TERAC_DEFAULT_AUDIENCE=general_population

# -----------------------------------------------------------------------------
# SPONSOR: Stripe — real revenue
# Keep one submitted Payment Link for all hackathon transactions.
# Do not put the organizer-facing restricted read key in the application.
# The fixed Dashboard Payment Link needs only the link and a webhook secret.
# -----------------------------------------------------------------------------
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=
STRIPE_CURRENCY=usd

# -----------------------------------------------------------------------------
# SPONSOR: Linq — iMessage, RCS, SMS, webhooks, and payment-link delivery
# LINQ_API_KEY is used by the V3 SDK. The Codex plugin currently reads
# LINQ_API_V3_API_KEY; set both to the same bearer token if you use both.
# Do not pin a sending number by default; let Linq select a healthy line.
# -----------------------------------------------------------------------------
LINQ_API_KEY=
LINQ_API_V3_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_WEBHOOK_URL=
LINQ_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# SPONSOR: Replay — autonomous QA
# -----------------------------------------------------------------------------
REPLAY_QA_API_TOKEN=
REPLAY_QA_BASE_URL=https://loop-qa.replay.io/api/v1
REPLAY_TARGET_URL=

# -----------------------------------------------------------------------------
# SPONSOR: Superserve — persistent Firecracker sandboxes for agent execution
# -----------------------------------------------------------------------------
SUPERSERVE_API_KEY=
SUPERSERVE_BASE_URL=https://api.superserve.ai
SUPERSERVE_TEMPLATE=paybench-browser
SUPERSERVE_TIMEOUT_SECONDS=3600
SUPERSERVE_AUTO_DELETE_SECONDS=86400
SUPERSERVE_PREVIEW_ACCESS=private
SUPERSERVE_PREVIEW_PORT=4173

# -----------------------------------------------------------------------------
# Study behavior. These values are configuration, not credentials.
# -----------------------------------------------------------------------------
STUDY_TARGET_PARTICIPANTS=20
STUDY_MIN_VALID_PER_VARIANT=6
STUDY_ASSIGNMENT_MODE=balanced_random
STUDY_SESSION_TTL_MINUTES=45
CAPTURE_CONFIDENCE_THRESHOLD=0.80

# -----------------------------------------------------------------------------
# REQUIRED INFRASTRUCTURE, NOT A HACKATHON SPONSOR: Anthropic
# Current Claude models accept text and image input, so one model handles both.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
