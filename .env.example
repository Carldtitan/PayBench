# Copy this file to .env and fill in only the services you use.
# Never commit .env or paste real credentials into this example file.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# REQUIRED SPONSOR: Terac — paid human research and expert feedback
# Create a key in Terac organization settings. Keys start with tk_.
# Codex can use OAuth instead: codex mcp login terac
# -----------------------------------------------------------------------------
TERAC_API_KEY=
TERAC_MCP_URL=https://terac.com/api/mcp
TERAC_DEFAULT_AUDIENCE=general_population

# -----------------------------------------------------------------------------
# SPONSOR: Stripe — real revenue
# Use LIVE keys only when the product is ready to accept real payments.
# Keep one submitted Payment Link for all hackathon transactions.
# Do not put the organizer-facing restricted read key in the application.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=
STRIPE_PRICE_ID=
STRIPE_CURRENCY=usd

# -----------------------------------------------------------------------------
# SPONSOR: Linq — iMessage, RCS, SMS, webhooks, and payment-link delivery
# LINQ_API_KEY is used by the V3 SDK. The Codex plugin currently reads
# LINQ_API_V3_API_KEY; set both to the same bearer token if you use both.
# Do not pin a sending number by default; let Linq select a healthy line.
# -----------------------------------------------------------------------------
LINQ_API_KEY=
LINQ_API_V3_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3
LINQ_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# SPONSOR: Replay — autonomous QA and time-travel debugging
# REPLAY_API_KEY is for recordings/MCP. Replay QA may issue a separate lqa_ token.
# -----------------------------------------------------------------------------
REPLAY_API_KEY=
REPLAY_QA_API_TOKEN=
REPLAY_QA_BASE_URL=https://loop-qa.replay.io/api/v1
REPLAY_MCP_URL=https://dispatch.replay.io/nut/mcp
REPLAY_TARGET_URL=

# -----------------------------------------------------------------------------
# SPONSOR: Superserve — persistent Firecracker sandboxes for agent execution
# -----------------------------------------------------------------------------
SUPERSERVE_API_KEY=
SUPERSERVE_TEMPLATE=superserve/base
SUPERSERVE_TIMEOUT_SECONDS=3600

# -----------------------------------------------------------------------------
# OPTIONAL SPONSOR: Pioneer — model inference/fine-tuning
# Keys start with pio_sk_. The API is OpenAI-compatible at the base URL below.
# -----------------------------------------------------------------------------
PIONEER_API_KEY=
PIONEER_BASE_URL=https://api.pioneer.ai/v1
PIONEER_MODEL=
PIONEER_ADAPTIVE_ROUTING=true

# -----------------------------------------------------------------------------
# OPTIONAL SPONSOR: Render — deployment; Workflows are required for its prize
# -----------------------------------------------------------------------------
RENDER_API_KEY=
RENDER_SERVICE_ID=

# -----------------------------------------------------------------------------
# OPTIONAL, NOT HACKATHON SPONSORS
# Use OpenAI only if Pioneer does not cover the model requirement.
# Use PostHog only if you need conversion-funnel analytics.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
